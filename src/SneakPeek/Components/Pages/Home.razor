@page "/"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@using SneakPeek.Models

<PageTitle>Home</PageTitle>

<h1>Movie List</h1>

<div class="search-box">
    <input type="text" @bind="_searchQuery" placeholder="Movie search..." />
    <button @onclick="Search">Search</button>
    <button @onclick="ClearSearch">Clear</button>
</div>

@if (movies == null)
{
    <p><em>Loading...</em></p>
}
else if (movies.Count == 0)
{
    <p>No movies found.</p>
}
else
{
    <ul>
        @foreach (var movie in movies)
        {
         <li>
             <p><strong>@movie.Title</strong>(@movie.Release_date) - @movie.Genre</p>
             <p>@movie.Description</p>
             <p><em>Directed by: @string.Join(",", movie.Directors)</em></p>
             <p>Rating: @movie.Rating</p>
             <p>Do you need to wait? - @movie.Wait</p>
         </li>   
        }
    </ul>
}


@code {
    private List<Movie>? movies;
    private string _searchQuery = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("MyHttpClient");
            movies = await client.GetFromJsonAsync<List<Movie>>("/movies");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching movies: {ex.Message}");
        }
    }

    private async Task Search()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("MyHttpClient");
            var encodedQuery = Uri.EscapeDataString(_searchQuery);
            movies = await client.GetFromJsonAsync<List<Movie>>($"/movies/search?query={encodedQuery}");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching movies: {ex.Message}");
            movies = new List<Movie>();
        }
    }

    private async Task ClearSearch()
    {
        _searchQuery = "";
        try
        {
            var client = HttpClientFactory.CreateClient("MyHttpClient");
            movies = await client.GetFromJsonAsync<List<Movie>>("/movies");
            StateHasChanged();
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error fetching movies: {ex.Message}");
        }
        catch (NotSupportedException ex)
        {
            Console.WriteLine($"Error fetching movies: {ex.Message}");
        }
        catch (System.Text.Json.JsonException ex)
        {
            Console.WriteLine($"Error fetching movies: {ex.Message}");
        }
    }
}